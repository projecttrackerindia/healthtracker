#!/usr/bin/env bash
# Build /etc/urbanhealth/app.env from env.yaml (non-secret) and Secret Manager (everything else).
#
# This is the piece Cloud Run did for us with --env-vars-file and --set-secrets. Doing it at service start
# rather than at image build time means rotating a secret is: add a new version, systemctl restart. Nothing
# is rebuilt and nothing is redeployed.
set -euo pipefail
OUT=/etc/urbanhealth/app.env
TMP=$(mktemp); trap 'rm -f "$TMP"' EXIT
chmod 600 "$TMP"
SRC=/opt/urbanhealth/repo/deploy/gcp

# env.yaml is simple `KEY: "value"` lines; no parser needed and none wanted on a boot path.
sed -n 's/^\([A-Z_][A-Z0-9_]*\):[[:space:]]*"\(.*\)"[[:space:]]*$/\1=\2/p' "$SRC/env.yaml" >> "$TMP"

missing=0
while read -r name; do
  case "$name" in ''|\#*) continue;; esac
  if val=$(gcloud secrets versions access latest --secret="$name" 2>/dev/null); then
    printf '%s=%s\n' "$name" "$val" >> "$TMP"
  else
    # Most of secrets.txt is optional — a watch cloud or a WhatsApp template that has no account yet. A
    # missing one must not stop the app booting, but it should be visible in the journal.
    echo "urbanhealth-env: no secret '$name' (skipping)" >&2
    missing=$((missing+1))
  fi
done < "$SRC/secrets.txt"

grep -q '^DATABASE_URL=' "$TMP" || { echo "urbanhealth-env: DATABASE_URL is missing — refusing to start"; exit 1; }
grep -q '^SECRET_KEY='   "$TMP" || { echo "urbanhealth-env: SECRET_KEY is missing — refusing to start"; exit 1; }

install -m 0600 "$TMP" "$OUT"
echo "urbanhealth-env: wrote $(grep -c . "$OUT") settings ($missing secrets absent)"
