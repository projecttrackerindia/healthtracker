# Copy to deploy/gcp/.env (never commit it) and fill in. Get the current values from Railway:  railway variables --kv
# DATA_KEY and SECRET_KEY MUST be the same as on Railway: DATA_KEY decrypts every family's stored record, SECRET_KEY keeps sessions valid.
DATA_KEY=
SECRET_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DOKKO_AI_MODEL=
RESEND_API_KEY=
MAIL_FROM=
# Google Workspace mail: smtp.gmail.com / 587 / the mailbox / an App Password (Admin → user → Security → App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
RAZORPAY_WEBHOOK_SECRET=
# filled in by setup.sh (Cloud SQL socket URL and the bucket's HMAC key) — leave empty here
DATABASE_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Watch clouds (optional). Register one developer app per service, callback <origin>/api/v1/fitbit/callback or /api/v1/wear/<withings|oura>/callback
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
# Firebase Phone Authentication = SMS codes without DLT paperwork (Google sends the SMS). Leave empty to keep SMS off.
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
