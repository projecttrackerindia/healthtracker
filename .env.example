# TheHealthTracker · Railway variables (service → Variables → Raw Editor: paste, then fill in)
# ---- required
DATA_KEY=                           # 64 random hex chars: encrypts family health data at rest; set once, never change
SECRET_KEY=                         # 64 random hex chars: python -c "import secrets;print(secrets.token_hex(32))"
ADMIN_EMAIL=admin@thehealthtracker.com
ADMIN_PASSWORD=                     # 12+ characters; creates the first admin at first start
DATABASE_URL=${{Postgres.DATABASE_URL}}
RP_ID=thehealthtracker.com          # passkeys: your domain, no https:// and no www (passkeys then work on www too)
APP_ORIGIN=https://thehealthtracker.com,https://www.thehealthtracker.com   # addresses people use (comma-separated)
# ---- one-time codes by email (choose one)
RESEND_API_KEY=                     # resend.com (verify your domain there)
MAIL_FROM=TheHealthTracker <no-reply@thehealthtracker.com>
SMTP_HOST=                          # or any SMTP: e.g. smtp.gmail.com / smtp.zoho.in / Amazon SES
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# ---- one-time codes by SMS (choose one; India needs a DLT-registered template)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=                  # OTP template containing ##OTP##
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# ---- optional features
ANTHROPIC_API_KEY=                  # AI reading of reports and prescriptions
DOKKO_AI_MODEL=claude-sonnet-5-5
RAZORPAY_KEY_ID=                    # live payments; demo billing when empty
RAZORPAY_KEY_SECRET=
DOKKO_REGION=IN
PWNED_CHECK=1                       # check new passwords against known breaches (k-anonymity); 0 to switch off
OTP_DEMO=0                          # 1 shows codes on screen instead of sending them: TESTING ONLY, never in production
